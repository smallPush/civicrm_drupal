<?php

/**
 * @file
 * Install, update and uninstall functions for the civicrm_secure profile.
 */

/**
 * Implements hook_install().
 *
 * Perform actions to set default frontend theme to smallpush_ui.
 */
function civicrm_secure_install(): void {
  // Set default frontend theme to smallpush_ui.
  \Drupal::configFactory()
    ->getEditable('system.theme')
    ->set('default', 'smallpush_ui')
    ->save();

  // Configure performance settings.
  $page_cache_max_age = getenv('DRUPAL_PAGE_CACHE_MAX_AGE');
  $max_age = ($page_cache_max_age !== false && $page_cache_max_age !== '') ? (int) $page_cache_max_age : 900;

  \Drupal::configFactory()
    ->getEditable('system.performance')
    ->set('cache.page.max_age', $max_age)
    ->set('css.preprocess', TRUE)
    ->set('js.preprocess', TRUE)
    ->save();
}
