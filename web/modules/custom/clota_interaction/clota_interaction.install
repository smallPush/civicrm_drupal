<?php

use Drupal\block\Entity\Block;
use Drupal\language\Entity\ConfigurableLanguage;
use Drupal\user\Entity\Role;

/**
 * Implements hook_schema().
 */
function clota_interaction_schema(): array {
  return [
    'clota_room_reservation' => [
      'description' => 'Stores reservations for Clota rooms.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'start_at' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
        'end_at' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
        'civicrm_activity_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
        'room' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'clota',
        ],
        'status' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'confirmed',
        ],
        'attendees' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
        'needs_tv' => [
          'type' => 'int',
          'size' => 'tiny',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'reservation_interval' => ['start_at', 'end_at'],
        'reservation_user' => ['uid'],
        'reservation_activity' => ['civicrm_activity_id'],
        'reservation_room_interval' => ['room', 'start_at', 'end_at'],
      ],
    ],
  ];
}

/**
 * Implements hook_install().
 */
function clota_interaction_install(): void {
  _clota_interaction_ensure_block();
  _clota_interaction_ensure_reservations();
  _clota_interaction_configure_catalan();
  _clota_interaction_ensure_reservation_activity_type();
  _clota_interaction_ensure_reservation_civicrm_config();
  _clota_interaction_ensure_agenda();
}

/**
 * Places the interactions block on existing installations.
 */
function clota_interaction_update_11001(): void {
  _clota_interaction_ensure_block();
}

/**
 * Translates the Clota interface and CiviCRM labels into Catalan.
 */
function clota_interaction_update_11002(): void {
  _clota_interaction_ensure_block();

  $block = Block::load('clota_interactions');
  $settings = $block->get('settings');
  $settings['label'] = 'Les meves interaccions';
  $block->set('settings', $settings)->save();

  $role = \Drupal\user\Entity\Role::load('usuario_clota');
  if ($role) {
    $role->set('label', 'usuari clota')->save();
  }

  $webform = \Drupal\webform\Entity\Webform::load('interaccion_clota');
  if ($webform) {
    $elements = $webform->getElementsDecoded();
    $elements['introduccion']['#text'] = 'Registra una interacció que hagis mantingut amb un altre usuari Clota.';
    $elements['civicrm_1_contact_1_contact_existing']['#title'] = 'Usuari que registra la interacció';
    $elements['civicrm_2_contact_1_contact_existing']['#title'] = 'Persona amb qui has interactuat';
    $elements['civicrm_2_contact_1_contact_existing']['#search_prompt'] = '- Selecciona un altre usuari Clota -';
    $elements['civicrm_2_contact_1_contact_existing']['#none_prompt'] = "No s'han trobat usuaris";
    $elements['civicrm_1_activity_1_activity_activity_date_time']['#title'] = 'Data de la interacció';
    $elements['civicrm_1_activity_1_activity_details']['#title'] = 'Notes';
    $elements['civicrm_1_activity_1_activity_details']['#description'] = 'Descriu breument la interacció.';
    $webform->set('title', 'Registrar interacció Clota');
    $webform->setElements($elements);
    $webform->setSetting('confirmation_message', "La interacció s'ha registrat correctament a CiviCRM.");
    $webform->save();

    $handler = $webform->getHandler('webform_civicrm');
    $configuration = $handler->getConfiguration();
    $configuration['settings']['data']['activity'][1]['activity'][1]['subject'] = 'Interacció Clota';
    $handler->setConfiguration($configuration);
    $webform->updateWebformHandler($handler);
  }

  \Drupal::service('civicrm')->initialize();
  $activityType = civicrm_api3('OptionValue', 'getsingle', [
    'option_group_id' => 'activity_type',
    'name' => 'Interaccion_Clota',
  ]);
  civicrm_api3('OptionValue', 'create', [
    'id' => $activityType['id'],
    'label' => 'Interacció Clota',
  ]);

  foreach ([
    'fundaciones_barcelona_importadas' => 'Fundacions de Barcelona importades',
    'usuarios_clota' => 'Usuaris Clota',
  ] as $name => $title) {
    $group = civicrm_api3('Group', 'getsingle', ['name' => $name]);
    civicrm_api3('Group', 'create', [
      'id' => $group['id'],
      'title' => $title,
    ]);
  }
}

/**
 * Translates existing Clota contacts and activity subjects into Catalan.
 */
function clota_interaction_update_11003(): void {
  \Drupal::service('civicrm')->initialize();

  $group = civicrm_api3('Group', 'getsingle', ['name' => 'usuarios_clota']);
  $memberships = civicrm_api3('GroupContact', 'get', [
    'group_id' => $group['id'],
    'status' => 'Added',
    'options' => ['limit' => 0],
  ]);
  foreach ($memberships['values'] as $membership) {
    civicrm_api3('Contact', 'create', [
      'id' => $membership['contact_id'],
      'first_name' => 'Usuari',
    ]);
  }

  $activities = civicrm_api3('Activity', 'get', [
    'activity_type_id' => 'Interaccion_Clota',
    'is_deleted' => 0,
    'options' => ['limit' => 0],
  ]);
  foreach ($activities['values'] as $activity) {
    civicrm_api3('Activity', 'create', [
      'id' => $activity['id'],
      'subject' => 'Interacció Clota',
    ]);
  }
}

/**
 * Enables weekly translation updates from Drupal's working endpoint.
 */
function clota_interaction_update_11004(): void {
  \Drupal::configFactory()
    ->getEditable('locale.settings')
    ->set('translation.default_server_pattern', 'https://ftp.drupal.org/files/translations/all/%project/%project-%version.%language.po')
    ->set('translation.update_interval_days', 7)
    ->save();
}

/**
 * Configures Catalan as the default language for Drupal and CiviCRM.
 */
function clota_interaction_update_11005(): void {
  _clota_interaction_configure_catalan();
}

/**
 * Creates the room reservation calendar and grants Clota user access.
 */
function clota_interaction_update_11006(): void {
  _clota_interaction_ensure_reservations();
}

/**
 * Adds the Clota user menu to the SmallPush header.
 */
function clota_interaction_update_11007(): void {
  _clota_interaction_ensure_menu();
}

/**
 * Moves the Clota menu to page preprocessing for reliable theme rendering.
 */
function clota_interaction_update_11008(): void {
  $block = Block::load('smallpush_ui_clota_menu');
  if ($block) {
    $block->delete();
  }
}

/**
 * Grants access to the member profile and public directory.
 */
function clota_interaction_update_11011(): void {
  $role = Role::load('usuario_clota');
  if ($role) {
    $role->grantPermission('edit own clota profile');
    $role->grantPermission('view clota directory');
    $role->save();
  }

  foreach (['anonymous', 'authenticated'] as $roleId) {
    $publicRole = Role::load($roleId);
    if ($publicRole) {
      $publicRole->grantPermission('view clota directory')->save();
    }
  }
}

/**
 * Restores multi-room storage and CiviCRM metadata on existing sites.
 */
function clota_interaction_update_11012(): void {
  _clota_interaction_ensure_reservation_activity_type();
  _clota_interaction_ensure_reservation_civicrm_config();

  $database = \Drupal::database();
  $schema = $database->schema();
  $definition = clota_interaction_schema()['clota_room_reservation'];
  foreach (['civicrm_activity_id', 'room', 'status', 'attendees', 'needs_tv'] as $field) {
    if (!$schema->fieldExists('clota_room_reservation', $field)) {
      $schema->addField('clota_room_reservation', $field, $definition['fields'][$field]);
    }
  }
  foreach ([
    'reservation_activity' => ['civicrm_activity_id'],
    'reservation_room_interval' => ['room', 'start_at', 'end_at'],
  ] as $index => $fields) {
    if (!$schema->indexExists('clota_room_reservation', $index)) {
      $schema->addIndex('clota_room_reservation', $index, $fields, $definition);
    }
  }

  $custom_fields = _clota_interaction_reservation_custom_fields();
  $reservations = $database->select('clota_room_reservation', 'r')
    ->fields('r')
    ->execute()
    ->fetchAll();
  foreach ($reservations as $reservation) {
    $activity_id = (int) ($reservation->civicrm_activity_id ?? 0);
    if (!$activity_id) {
      $activity_id = _clota_interaction_create_reservation_activity(
        (int) $reservation->uid,
        (int) $reservation->start_at,
        (int) $reservation->end_at,
        (string) $reservation->room,
        isset($reservation->attendees) ? (int) $reservation->attendees : NULL,
        isset($reservation->needs_tv) ? (bool) $reservation->needs_tv : NULL,
        (string) $reservation->status,
      );
      $database->update('clota_room_reservation')
        ->fields(['civicrm_activity_id' => $activity_id])
        ->condition('id', (int) $reservation->id)
        ->execute();
    }

    $room_label = _clota_interaction_room_labels()[$reservation->room] ?? $reservation->room;
    civicrm_api3('Activity', 'create', [
      'id' => $activity_id,
      $custom_fields['Sala_Clota'] => $room_label,
      $custom_fields['Estat_Reserva'] => $reservation->status === 'pending_validation'
        ? 'Pendent de validar per Administració de la Clota'
        : 'Confirmada',
      'check_permissions' => FALSE,
    ]);
  }

  _clota_interaction_ensure_reservations();
  _clota_interaction_ensure_block();
}

/**
 * Creates the public agenda fields, event types, and initial activities.
 */
function clota_interaction_update_11013(): void {
  _clota_interaction_ensure_agenda();
}

/**
 * Creates the CiviCRM configuration and initial events for the agenda.
 */
function _clota_interaction_ensure_agenda(): void {
  \Drupal::service('civicrm')->initialize();

  $groups = civicrm_api3('CustomGroup', 'get', [
    'name' => 'Agenda_La_Clota',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($groups['values'])) {
    $group = civicrm_api3('CustomGroup', 'create', [
      'name' => 'Agenda_La_Clota',
      'title' => 'Agenda de La Clota',
      'extends' => 'Event',
      'style' => 'Inline',
      'is_active' => 1,
    ]);
    $group_id = (int) $group['id'];
  }
  else {
    $group_id = (int) reset($groups['values'])['id'];
  }

  $fields = civicrm_api3('CustomField', 'get', [
    'custom_group_id' => $group_id,
    'name' => 'Sala_Agenda',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($fields['values'])) {
    $field = civicrm_api3('CustomField', 'create', [
      'custom_group_id' => $group_id,
      'name' => 'Sala_Agenda',
      'label' => 'Sala / ubicació',
      'data_type' => 'String',
      'html_type' => 'Text',
      'is_searchable' => 1,
      'is_active' => 1,
    ]);
    $room_field = 'custom_' . $field['id'];
  }
  else {
    $room_field = 'custom_' . reset($fields['values'])['id'];
  }

  $type_definitions = [
    'Clota_Networking' => 'Networking',
    'Clota_Taller_Formacio' => 'Taller / Formació',
    'Clota_Afterwork' => 'Afterwork',
    'Clota_Comunitat_Esmorzar' => 'Comunitat / Esmorzar',
    'Clota_Conferencia' => 'Conferència',
  ];
  $type_ids = [];
  foreach ($type_definitions as $name => $label) {
    $existing = civicrm_api3('OptionValue', 'get', [
      'option_group_id' => 'event_type',
      'name' => $name,
      'return' => ['value'],
      'options' => ['limit' => 1],
    ]);
    if (empty($existing['values'])) {
      civicrm_api3('OptionValue', 'create', [
        'option_group_id' => 'event_type',
        'name' => $name,
        'label' => $label,
        'is_active' => 1,
      ]);
      $existing = civicrm_api3('OptionValue', 'get', [
        'option_group_id' => 'event_type',
        'name' => $name,
        'return' => ['value'],
        'options' => ['limit' => 1],
      ]);
    }
    $type_ids[$name] = (int) reset($existing['values'])['value'];
  }

  $events = [
    [
      'title' => 'Esmorzar de comunitat: connexions que sumen',
      'summary' => '<p>Esmorzar informal per conèixer projectes, necessitats i oportunitats de col·laboració dins de La Clota.</p>',
      'description' => '<p>Comencem el dia compartint cafè, idees i noves connexions.</p><p>Cada participant disposarà d’un minut per presentar el seu projecte o explicar quin tipus de col·laboració busca.</p>',
      'start_date' => '2026-06-18 09:00:00',
      'end_date' => '2026-06-18 10:30:00',
      'type' => 'Clota_Comunitat_Esmorzar',
      'room' => 'Espai Obert',
    ],
    [
      'title' => 'Taller pràctic d’IA generativa per a equips petits',
      'summary' => '<p>Sessió aplicada per integrar eines d’intel·ligència artificial en processos quotidians.</p>',
      'description' => '<p>Taller pràctic sobre redacció, recerca, automatització i anàlisi amb IA generativa.</p><p>Cal portar ordinador portàtil. No es requereixen coneixements tècnics previs.</p>',
      'start_date' => '2026-07-02 17:00:00',
      'end_date' => '2026-07-02 19:30:00',
      'type' => 'Clota_Taller_Formacio',
      'room' => 'Sala Polivalent',
    ],
    [
      'title' => 'Pitch Lab: presenta el teu projecte en 3 minuts',
      'summary' => '<p>Sessió de pràctica i feedback per millorar la presentació de projectes emprenedors.</p>',
      'description' => '<p>Una trobada orientada a professionals i equips que vulguin millorar el seu pitch.</p><p>Treballarem estructura, missatge, proposta de valor i comunicació no verbal.</p>',
      'start_date' => '2026-07-23 18:00:00',
      'end_date' => '2026-07-23 20:00:00',
      'type' => 'Clota_Networking',
      'room' => 'Sala de Reunions',
    ],
    [
      'title' => 'Afterwork d’estiu / Afterwork de verano',
      'summary' => '<p>Trobada distesa a la terrassa per connectar amb professionals i projectes de l’entorn.</p>',
      'description' => '<p>Tanquem la jornada amb conversa, música i networking informal.</p><p>L’activitat és oberta a membres de La Clota i persones convidades.</p>',
      'start_date' => '2026-08-06 18:30:00',
      'end_date' => '2026-08-06 21:00:00',
      'type' => 'Clota_Afterwork',
      'room' => 'Terrassa',
    ],
    [
      'title' => 'Negocis amb impacte: de la idea a un model sostenible',
      'summary' => '<p>Conversa sobre models de negoci que combinen viabilitat econòmica i impacte social.</p>',
      'description' => '<p>Professionals de l’emprenedoria social compartiran experiències, errors i aprenentatges.</p><p>La sessió acabarà amb preguntes del públic i un espai de connexió.</p>',
      'start_date' => '2026-08-27 18:00:00',
      'end_date' => '2026-08-27 20:00:00',
      'type' => 'Clota_Conferencia',
      'room' => 'Sala Polivalent',
    ],
    [
      'title' => 'Esmorzar de comunitat: tornem amb noves idees',
      'summary' => '<p>Primera trobada de comunitat després de l’estiu per compartir objectius i noves iniciatives.</p>',
      'description' => '<p>Una sessió breu i participativa per retrobar-nos i descobrir els projectes que arriben a La Clota.</p><p>Inclou cafè, esmorzar lleuger i ronda de presentacions.</p>',
      'start_date' => '2026-09-17 09:00:00',
      'end_date' => '2026-09-17 10:30:00',
      'type' => 'Clota_Comunitat_Esmorzar',
      'room' => 'Espai Obert',
    ],
    [
      'title' => 'Taller de ciberseguretat per a persones autònomes',
      'summary' => '<p>Mesures senzilles per protegir dispositius, comptes, dades de clients i còpies de seguretat.</p>',
      'description' => '<p>Revisarem els principals riscos digitals per a professionals independents i microempreses.</p><p>La sessió inclou una llista de comprovació i exercicis pràctics. Cal portar ordinador.</p>',
      'start_date' => '2026-10-01 16:30:00',
      'end_date' => '2026-10-01 19:00:00',
      'type' => 'Clota_Taller_Formacio',
      'room' => 'Sala de Reunions',
    ],
    [
      'title' => 'Speed Networking: talent, projectes i col·laboracions',
      'summary' => '<p>Rondes de converses breus per trobar clients, proveïdors, talent o projectes compartits.</p>',
      'description' => '<p>Una dinàmica de networking estructurada amb converses de cinc minuts.</p><p>En inscriure’t, indica què ofereixes i quin tipus de contacte estàs buscant.</p>',
      'start_date' => '2026-10-15 18:00:00',
      'end_date' => '2026-10-15 20:00:00',
      'type' => 'Clota_Networking',
      'room' => 'Sala Polivalent',
    ],
    [
      'title' => 'Masterclass de finances per a projectes creatius',
      'summary' => '<p>Com calcular preus, controlar tresoreria i prendre decisions amb indicadors senzills.</p>',
      'description' => '<p>Masterclass dirigida a professionals creatius, cooperatives i petits equips.</p><p>Treballarem pressupostos, marge, previsió de caixa i planificació d’ingressos.</p>',
      'start_date' => '2026-11-05 17:00:00',
      'end_date' => '2026-11-05 19:30:00',
      'type' => 'Clota_Conferencia',
      'room' => 'Sala Polivalent',
    ],
    [
      'title' => 'Afterwork de tardor: comunitat en obert',
      'summary' => '<p>Trobada oberta per descobrir La Clota i connectar amb la seva comunitat professional.</p>',
      'description' => '<p>Una tarda per conèixer membres, iniciatives i oportunitats de col·laboració.</p><p>Hi haurà una breu presentació de projectes seguida de networking informal.</p>',
      'start_date' => '2026-11-26 18:30:00',
      'end_date' => '2026-11-26 21:00:00',
      'type' => 'Clota_Afterwork',
      'room' => 'Espai Obert',
    ],
  ];

  foreach ($events as $event) {
    $existing = civicrm_api3('Event', 'get', [
      'title' => $event['title'],
      'return' => ['id'],
      'options' => ['limit' => 1],
      'check_permissions' => FALSE,
    ]);
    if (!empty($existing['values'])) {
      continue;
    }
    civicrm_api3('Event', 'create', [
      'title' => $event['title'],
      'summary' => $event['summary'],
      'description' => $event['description'],
      'start_date' => $event['start_date'],
      'end_date' => $event['end_date'],
      'event_type_id' => $type_ids[$event['type']],
      'is_public' => 1,
      'is_active' => 1,
      'is_online_registration' => 1,
      'registration_link_text' => 'Inscriu-t’hi',
      'is_monetary' => 0,
      'is_show_location' => 1,
      'default_role_id' => 1,
      'check_permissions' => FALSE,
      $room_field => $event['room'],
    ]);
  }
}

/**
 * Creates the CiviCRM activity type used for room reservations.
 */
function _clota_interaction_ensure_reservation_activity_type(): void {
  \Drupal::service('civicrm')->initialize();
  $existing = civicrm_api3('OptionValue', 'get', [
    'option_group_id' => 'activity_type',
    'name' => 'Reserva_Sala',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($existing['values'])) {
    civicrm_api3('OptionValue', 'create', [
      'option_group_id' => 'activity_type',
      'name' => 'Reserva_Sala',
      'label' => 'Reserva de sala',
      'is_active' => 1,
    ]);
  }
}

/**
 * Creates the CiviCRM approval status and reservation fields.
 */
function _clota_interaction_ensure_reservation_civicrm_config(): void {
  \Drupal::service('civicrm')->initialize();
  $status = civicrm_api3('OptionValue', 'get', [
    'option_group_id' => 'activity_status',
    'name' => 'Pending_Clota_Approval',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($status['values'])) {
    civicrm_api3('OptionValue', 'create', [
      'option_group_id' => 'activity_status',
      'name' => 'Pending_Clota_Approval',
      'label' => 'Pendent de validar per Administració de la Clota',
      'is_active' => 1,
    ]);
  }

  $groups = civicrm_api3('CustomGroup', 'get', [
    'name' => 'Clota_Room_Reservation',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($groups['values'])) {
    $group = civicrm_api3('CustomGroup', 'create', [
      'name' => 'Clota_Room_Reservation',
      'title' => 'Reserva de sala Clota',
      'extends' => 'Activity',
      'style' => 'Inline',
      'collapse_display' => 1,
      'is_active' => 1,
    ]);
    $group_id = (int) $group['id'];
  }
  else {
    $group_id = (int) reset($groups['values'])['id'];
  }

  $definitions = [
    'Sala_Clota' => ['label' => 'Sala', 'data_type' => 'String', 'html_type' => 'Text'],
    'Nombre_Assistents' => ['label' => 'Nombre d’assistents', 'data_type' => 'Int', 'html_type' => 'Text'],
    'Necessita_Televisio' => ['label' => 'Necessita televisió', 'data_type' => 'Boolean', 'html_type' => 'Radio'],
    'Estat_Reserva' => ['label' => 'Estat de la reserva', 'data_type' => 'String', 'html_type' => 'Text'],
  ];
  foreach ($definitions as $name => $field) {
    $existing = civicrm_api3('CustomField', 'get', [
      'custom_group_id' => $group_id,
      'name' => $name,
      'return' => ['id'],
      'options' => ['limit' => 1],
    ]);
    if (empty($existing['values'])) {
      civicrm_api3('CustomField', 'create', $field + [
        'custom_group_id' => $group_id,
        'name' => $name,
        'is_active' => 1,
      ]);
    }
  }
}

/**
 * Configures Catalan for the site and existing users.
 */
function _clota_interaction_configure_catalan(): void {
  if (!ConfigurableLanguage::load('ca')) {
    ConfigurableLanguage::createFromLangcode('ca')->save();
  }

  \Drupal::configFactory()
    ->getEditable('system.site')
    ->set('default_langcode', 'ca')
    ->save();
  \Drupal::configFactory()
    ->getEditable('system.date')
    ->set('timezone.default', 'Europe/Madrid')
    ->save();

  $users = \Drupal::entityTypeManager()->getStorage('user')->loadMultiple();
  foreach ($users as $user) {
    if (!$user->isAnonymous()) {
      $user->set('preferred_langcode', 'ca');
      $user->set('preferred_admin_langcode', 'ca');
      $user->set('timezone', 'Europe/Madrid');
      $user->save();
    }
  }

  \Drupal::service('civicrm')->initialize();
  Civi::settings()->set('lcMessages', 'ca_ES');
}

/**
 * Creates reservation storage, permission, and block placement.
 */
function _clota_interaction_ensure_reservations(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('clota_room_reservation')) {
    $definition = clota_interaction_schema()['clota_room_reservation'];
    $schema->createTable('clota_room_reservation', $definition);
  }

  $role = Role::load('usuario_clota');
  if ($role) {
    $role->grantPermission('reserve clota room')->save();
  }

  $block = Block::load('clota_room_reservations');
  if (!$block) {
    $block = Block::create([
      'id' => 'clota_room_reservations',
      'theme' => 'smallpush_ui',
      'plugin' => 'clota_room_reservations',
    ]);
  }
  $block->setRegion('content_below');
  $block->setWeight(1);
  $block->set('settings', [
    'id' => 'clota_room_reservations',
    'label' => 'Calendari de reserves',
    'label_display' => TRUE,
    'provider' => 'clota_interaction',
  ]);
  $block->setVisibilityConfig('request_path', [
    'id' => 'request_path',
    'negate' => FALSE,
    'pages' => '/reserva-sala',
  ]);
  $block->save();
}

/**
 * Places the Clota menu in the primary menu region for Clota users.
 */
function _clota_interaction_ensure_menu(): void {
  $block = Block::load('smallpush_ui_clota_menu');
  if (!$block) {
    $block = Block::create([
      'id' => 'smallpush_ui_clota_menu',
      'theme' => 'smallpush_ui',
      'plugin' => 'system_menu_block:main',
    ]);
  }

  $block->setRegion('primary_menu');
  $block->setWeight(0);
  $block->set('settings', [
    'id' => 'system_menu_block:main',
    'label' => 'Menú Clota',
    'label_display' => FALSE,
    'provider' => 'system',
    'level' => 1,
    'depth' => 0,
    'expand_all_items' => FALSE,
  ]);
  $block->setVisibilityConfig('user_role', [
    'id' => 'user_role',
    'negate' => FALSE,
    'roles' => ['usuario_clota' => 'usuario_clota'],
  ]);
  $block->save();
}

/**
 * Creates or updates the interactions block placement.
 */
function _clota_interaction_ensure_block(): void {
  $block = Block::load('clota_interactions');
  if (!$block) {
    $block = Block::create([
      'id' => 'clota_interactions',
      'theme' => 'smallpush_ui',
      'plugin' => 'clota_interactions',
    ]);
  }

  $block->setRegion('content_below');
  $block->setWeight(0);
  $block->set('settings', [
    'id' => 'clota_interactions',
    'label' => 'El meu historial',
    'label_display' => TRUE,
    'provider' => 'clota_interaction',
  ]);
  $block->setVisibilityConfig('request_path', [
    'id' => 'request_path',
    'negate' => FALSE,
    'pages' => "/form/interaccion-clota\n/reserva-sala",
  ]);
  $block->save();
}
