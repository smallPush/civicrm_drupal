<?php

use Drupal\block\Entity\Block;
use Drupal\language\Entity\ConfigurableLanguage;
use Drupal\user\Entity\Role;

/**
 * Implements hook_schema().
 */
function clota_interaction_schema(): array {
  return [
    'clota_room_reservation' => [
      'description' => 'Stores reservations for Clota rooms.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'start_at' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
        'end_at' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
        'civicrm_activity_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
        'room' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'clota',
        ],
        'status' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'confirmed',
        ],
        'attendees' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
        'needs_tv' => [
          'type' => 'int',
          'size' => 'tiny',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'reservation_interval' => ['start_at', 'end_at'],
        'reservation_user' => ['uid'],
        'reservation_activity' => ['civicrm_activity_id'],
        'reservation_room_interval' => ['room', 'start_at', 'end_at'],
      ],
    ],
  ];
}

/**
 * Implements hook_install().
 */
function clota_interaction_install(): void {
  _clota_interaction_ensure_block();
  _clota_interaction_ensure_reservations();
  _clota_interaction_configure_catalan();
  _clota_interaction_ensure_reservation_activity_type();
  _clota_interaction_ensure_reservation_civicrm_config();
}

/**
 * Places the interactions block on existing installations.
 */
function clota_interaction_update_11001(): void {
  _clota_interaction_ensure_block();
}

/**
 * Translates the Clota interface and CiviCRM labels into Catalan.
 */
function clota_interaction_update_11002(): void {
  _clota_interaction_ensure_block();

  $block = Block::load('clota_interactions');
  $settings = $block->get('settings');
  $settings['label'] = 'Les meves interaccions';
  $block->set('settings', $settings)->save();

  $role = \Drupal\user\Entity\Role::load('usuario_clota');
  if ($role) {
    $role->set('label', 'usuari clota')->save();
  }

  $webform = \Drupal\webform\Entity\Webform::load('interaccion_clota');
  if ($webform) {
    $elements = $webform->getElementsDecoded();
    $elements['introduccion']['#text'] = 'Registra una interacció que hagis mantingut amb un altre usuari Clota.';
    $elements['civicrm_1_contact_1_contact_existing']['#title'] = 'Usuari que registra la interacció';
    $elements['civicrm_2_contact_1_contact_existing']['#title'] = 'Persona amb qui has interactuat';
    $elements['civicrm_2_contact_1_contact_existing']['#search_prompt'] = '- Selecciona un altre usuari Clota -';
    $elements['civicrm_2_contact_1_contact_existing']['#none_prompt'] = "No s'han trobat usuaris";
    $elements['civicrm_1_activity_1_activity_activity_date_time']['#title'] = 'Data de la interacció';
    $elements['civicrm_1_activity_1_activity_details']['#title'] = 'Notes';
    $elements['civicrm_1_activity_1_activity_details']['#description'] = 'Descriu breument la interacció.';
    $webform->set('title', 'Registrar interacció Clota');
    $webform->setElements($elements);
    $webform->setSetting('confirmation_message', "La interacció s'ha registrat correctament a CiviCRM.");
    $webform->save();

    $handler = $webform->getHandler('webform_civicrm');
    $configuration = $handler->getConfiguration();
    $configuration['settings']['data']['activity'][1]['activity'][1]['subject'] = 'Interacció Clota';
    $handler->setConfiguration($configuration);
    $webform->updateWebformHandler($handler);
  }

  \Drupal::service('civicrm')->initialize();
  $activityType = civicrm_api3('OptionValue', 'getsingle', [
    'option_group_id' => 'activity_type',
    'name' => 'Interaccion_Clota',
  ]);
  civicrm_api3('OptionValue', 'create', [
    'id' => $activityType['id'],
    'label' => 'Interacció Clota',
  ]);

  foreach ([
    'fundaciones_barcelona_importadas' => 'Fundacions de Barcelona importades',
    'usuarios_clota' => 'Usuaris Clota',
  ] as $name => $title) {
    $group = civicrm_api3('Group', 'getsingle', ['name' => $name]);
    civicrm_api3('Group', 'create', [
      'id' => $group['id'],
      'title' => $title,
    ]);
  }
}

/**
 * Translates existing Clota contacts and activity subjects into Catalan.
 */
function clota_interaction_update_11003(): void {
  \Drupal::service('civicrm')->initialize();

  $group = civicrm_api3('Group', 'getsingle', ['name' => 'usuarios_clota']);
  $memberships = civicrm_api3('GroupContact', 'get', [
    'group_id' => $group['id'],
    'status' => 'Added',
    'options' => ['limit' => 0],
  ]);
  foreach ($memberships['values'] as $membership) {
    civicrm_api3('Contact', 'create', [
      'id' => $membership['contact_id'],
      'first_name' => 'Usuari',
    ]);
  }

  $activities = civicrm_api3('Activity', 'get', [
    'activity_type_id' => 'Interaccion_Clota',
    'is_deleted' => 0,
    'options' => ['limit' => 0],
  ]);
  foreach ($activities['values'] as $activity) {
    civicrm_api3('Activity', 'create', [
      'id' => $activity['id'],
      'subject' => 'Interacció Clota',
    ]);
  }
}

/**
 * Enables weekly translation updates from Drupal's working endpoint.
 */
function clota_interaction_update_11004(): void {
  \Drupal::configFactory()
    ->getEditable('locale.settings')
    ->set('translation.default_server_pattern', 'https://ftp.drupal.org/files/translations/all/%project/%project-%version.%language.po')
    ->set('translation.update_interval_days', 7)
    ->save();
}

/**
 * Configures Catalan as the default language for Drupal and CiviCRM.
 */
function clota_interaction_update_11005(): void {
  _clota_interaction_configure_catalan();
}

/**
 * Creates the room reservation calendar and grants Clota user access.
 */
function clota_interaction_update_11006(): void {
  _clota_interaction_ensure_reservations();
}

/**
 * Adds the Clota user menu to the SmallPush header.
 */
function clota_interaction_update_11007(): void {
  _clota_interaction_ensure_menu();
}

/**
 * Moves the Clota menu to page preprocessing for reliable theme rendering.
 */
function clota_interaction_update_11008(): void {
  $block = Block::load('smallpush_ui_clota_menu');
  if ($block) {
    $block->delete();
  }
}

/**
 * Adds room reservations to the shared CiviCRM activity history.
 */
function clota_interaction_update_11009(): void {
  _clota_interaction_ensure_reservation_activity_type();
  _clota_interaction_ensure_reservation_civicrm_config();
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('clota_room_reservation', 'civicrm_activity_id')) {
    $schema->addField('clota_room_reservation', 'civicrm_activity_id', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
    ]);
  }
  if (!$schema->indexExists('clota_room_reservation', 'reservation_activity')) {
    $schema->addIndex(
      'clota_room_reservation',
      'reservation_activity',
      ['civicrm_activity_id'],
      clota_interaction_schema()['clota_room_reservation'],
    );
  }

  $reservations = \Drupal::database()->select('clota_room_reservation', 'r')
    ->fields('r', ['id', 'uid', 'start_at', 'end_at'])
    ->isNull('civicrm_activity_id')
    ->execute()
    ->fetchAll();
  foreach ($reservations as $reservation) {
    $activity_id = _clota_interaction_create_reservation_activity(
      (int) $reservation->uid,
      (int) $reservation->start_at,
      (int) $reservation->end_at,
    );
    \Drupal::database()->update('clota_room_reservation')
      ->fields(['civicrm_activity_id' => $activity_id])
      ->condition('id', (int) $reservation->id)
      ->execute();
  }

  _clota_interaction_ensure_block();
}

/**
 * Adds multiple rooms and external-room approval metadata.
 */
function clota_interaction_update_11010(): void {
  $schema = \Drupal::database()->schema();
  $definition = clota_interaction_schema()['clota_room_reservation'];
  foreach (['room', 'status', 'attendees', 'needs_tv'] as $field) {
    if (!$schema->fieldExists('clota_room_reservation', $field)) {
      $schema->addField('clota_room_reservation', $field, $definition['fields'][$field]);
    }
  }
  if (!$schema->indexExists('clota_room_reservation', 'reservation_room_interval')) {
    $schema->addIndex(
      'clota_room_reservation',
      'reservation_room_interval',
      ['room', 'start_at', 'end_at'],
      $definition,
    );
  }

  _clota_interaction_ensure_reservation_civicrm_config();
  $fields = _clota_interaction_reservation_custom_fields();
  $reservations = \Drupal::database()->select('clota_room_reservation', 'r')
    ->fields('r', ['civicrm_activity_id', 'room', 'status'])
    ->isNotNull('civicrm_activity_id')
    ->execute()
    ->fetchAll();
  foreach ($reservations as $reservation) {
    $room_label = _clota_interaction_room_labels()[$reservation->room] ?? $reservation->room;
    civicrm_api3('Activity', 'create', [
      'id' => (int) $reservation->civicrm_activity_id,
      $fields['Sala_Clota'] => $room_label,
      $fields['Estat_Reserva'] => $reservation->status === 'pending_validation'
        ? 'Pendent de validar per Administració de la Clota'
        : 'Confirmada',
      'check_permissions' => FALSE,
    ]);
  }
}

/**
 * Creates the CiviCRM activity type used for room reservations.
 */
function _clota_interaction_ensure_reservation_activity_type(): void {
  \Drupal::service('civicrm')->initialize();
  $existing = civicrm_api3('OptionValue', 'get', [
    'option_group_id' => 'activity_type',
    'name' => 'Reserva_Sala',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($existing['values'])) {
    civicrm_api3('OptionValue', 'create', [
      'option_group_id' => 'activity_type',
      'name' => 'Reserva_Sala',
      'label' => 'Reserva de sala',
      'is_active' => 1,
    ]);
  }
}

/**
 * Creates the CiviCRM approval status and structured reservation fields.
 */
function _clota_interaction_ensure_reservation_civicrm_config(): void {
  \Drupal::service('civicrm')->initialize();
  $status = civicrm_api3('OptionValue', 'get', [
    'option_group_id' => 'activity_status',
    'name' => 'Pending_Clota_Approval',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($status['values'])) {
    civicrm_api3('OptionValue', 'create', [
      'option_group_id' => 'activity_status',
      'name' => 'Pending_Clota_Approval',
      'label' => 'Pendent de validar per Administració de la Clota',
      'is_active' => 1,
    ]);
  }

  $groups = civicrm_api3('CustomGroup', 'get', [
    'name' => 'Clota_Room_Reservation',
    'return' => ['id'],
    'options' => ['limit' => 1],
  ]);
  if (empty($groups['values'])) {
    $group = civicrm_api3('CustomGroup', 'create', [
      'name' => 'Clota_Room_Reservation',
      'title' => 'Reserva de sala Clota',
      'extends' => 'Activity',
      'style' => 'Inline',
      'collapse_display' => 1,
      'is_active' => 1,
    ]);
    $group_id = (int) $group['id'];
  }
  else {
    $group_id = (int) reset($groups['values'])['id'];
  }

  $definitions = [
    'Sala_Clota' => ['label' => 'Sala', 'data_type' => 'String', 'html_type' => 'Text'],
    'Nombre_Assistents' => ['label' => 'Nombre d’assistents', 'data_type' => 'Int', 'html_type' => 'Text'],
    'Necessita_Televisio' => ['label' => 'Necessita televisió', 'data_type' => 'Boolean', 'html_type' => 'Radio'],
    'Estat_Reserva' => ['label' => 'Estat de la reserva', 'data_type' => 'String', 'html_type' => 'Text'],
  ];
  foreach ($definitions as $name => $field) {
    $existing = civicrm_api3('CustomField', 'get', [
      'custom_group_id' => $group_id,
      'name' => $name,
      'return' => ['id'],
      'options' => ['limit' => 1],
    ]);
    if (empty($existing['values'])) {
      civicrm_api3('CustomField', 'create', $field + [
        'custom_group_id' => $group_id,
        'name' => $name,
        'is_active' => 1,
      ]);
    }
  }
}

/**
 * Configures Catalan for the site and existing users.
 */
function _clota_interaction_configure_catalan(): void {
  if (!ConfigurableLanguage::load('ca')) {
    ConfigurableLanguage::createFromLangcode('ca')->save();
  }

  \Drupal::configFactory()
    ->getEditable('system.site')
    ->set('default_langcode', 'ca')
    ->save();
  \Drupal::configFactory()
    ->getEditable('system.date')
    ->set('timezone.default', 'Europe/Madrid')
    ->save();

  $users = \Drupal::entityTypeManager()->getStorage('user')->loadMultiple();
  foreach ($users as $user) {
    if (!$user->isAnonymous()) {
      $user->set('preferred_langcode', 'ca');
      $user->set('preferred_admin_langcode', 'ca');
      $user->set('timezone', 'Europe/Madrid');
      $user->save();
    }
  }

  \Drupal::service('civicrm')->initialize();
  Civi::settings()->set('lcMessages', 'ca_ES');
}

/**
 * Creates reservation storage, permission, and block placement.
 */
function _clota_interaction_ensure_reservations(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('clota_room_reservation')) {
    $definition = clota_interaction_schema()['clota_room_reservation'];
    $schema->createTable('clota_room_reservation', $definition);
  }

  $role = Role::load('usuario_clota');
  if ($role) {
    $role->grantPermission('reserve clota room')->save();
  }

  $block = Block::load('clota_room_reservations');
  if (!$block) {
    $block = Block::create([
      'id' => 'clota_room_reservations',
      'theme' => 'smallpush_ui',
      'plugin' => 'clota_room_reservations',
    ]);
  }
  $block->setRegion('content_below');
  $block->setWeight(1);
  $block->set('settings', [
    'id' => 'clota_room_reservations',
    'label' => 'Calendari de reserves',
    'label_display' => TRUE,
    'provider' => 'clota_interaction',
  ]);
  $block->setVisibilityConfig('request_path', [
    'id' => 'request_path',
    'negate' => FALSE,
    'pages' => '/reserva-sala',
  ]);
  $block->save();
}

/**
 * Places the Clota menu in the primary menu region for Clota users.
 */
function _clota_interaction_ensure_menu(): void {
  $block = Block::load('smallpush_ui_clota_menu');
  if (!$block) {
    $block = Block::create([
      'id' => 'smallpush_ui_clota_menu',
      'theme' => 'smallpush_ui',
      'plugin' => 'system_menu_block:main',
    ]);
  }

  $block->setRegion('primary_menu');
  $block->setWeight(0);
  $block->set('settings', [
    'id' => 'system_menu_block:main',
    'label' => 'Menú Clota',
    'label_display' => FALSE,
    'provider' => 'system',
    'level' => 1,
    'depth' => 0,
    'expand_all_items' => FALSE,
  ]);
  $block->setVisibilityConfig('user_role', [
    'id' => 'user_role',
    'negate' => FALSE,
    'roles' => ['usuario_clota' => 'usuario_clota'],
  ]);
  $block->save();
}

/**
 * Creates or updates the interactions block placement.
 */
function _clota_interaction_ensure_block(): void {
  $block = Block::load('clota_interactions');
  if (!$block) {
    $block = Block::create([
      'id' => 'clota_interactions',
      'theme' => 'smallpush_ui',
      'plugin' => 'clota_interactions',
    ]);
  }

  $block->setRegion('content_below');
  $block->setWeight(0);
  $block->set('settings', [
    'id' => 'clota_interactions',
    'label' => 'El meu historial',
    'label_display' => TRUE,
    'provider' => 'clota_interaction',
  ]);
  $block->setVisibilityConfig('request_path', [
    'id' => 'request_path',
    'negate' => FALSE,
    'pages' => "/form/interaccion-clota\n/reserva-sala",
  ]);
  $block->save();
}
